DATABASE_URL="postgresql://user:password@localhost:5432/db_name"
JWT_SECRET="your-super-secret-key"
COOKIE_SECRET="your-super-secret-cookie-key"

# Most hosts (Render included) inject this automatically for web services —
# only set it manually to override the local-dev default.
PORT="3020"

# vertex-web's own origin. Drives both CORS (main.ts) and the OAuth
# callback redirect: after a successful OAuth login, the popup is
# redirected here (to /auth/callback?code=...) with a short-lived,
# single-use exchange code — never the real token, since URLs can end up
# in browser history, Referer headers, or proxy logs — which vertex-web
# trades for the real token via POST /auth/exchange and sets as a cookie
# on its own domain instead of this API's.
FRONTEND_URL="http://localhost:3000"
AWS_REGION="us-east-1"
# Read by the AWS SDK itself, not by this app. Required where it has no
# identity of its own, which is any container host outside AWS. Leave both
# empty when it runs somewhere that gives it a role — a Lambda execution
# role, an ECS task role — and the SDK uses that instead.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""

# Where the app reads the rest of its configuration from, when it is not
# reading it from here. Set to an SSM Parameter Store path prefix
# (e.g. /vertex-api/) and everything under it is loaded into the environment
# once per execution environment, at cold start. Unset, this file and the
# shell are the only source — which is what local dev and the e2e suite use.
# Anything already set in the environment always wins over the store.
CONFIG_PARAMETER_PREFIX=""

# Where rate-limit counters live. Unset (the default) keeps them in the API
# process, which is correct while exactly one process serves this URL — on a
# second instance each one would grant the full limit by itself. Set it to a
# DynamoDB table name to share the counters. Costs a round trip on every
# request, so the table belongs in the same region as the app.
THROTTLER_DDB_TABLE=""
# Falls back to AWS_REGION when unset.
THROTTLER_DDB_REGION=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3333/auth/google/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3333/auth/github/callback"

ADMIN_EMAIL=""

# Shared secret proving a request came through the CDN in front of this API,
# rather than straight to its origin. Set it to the same value the CDN is
# configured to send as the x-origin-verify origin header. Unset (the default)
# accepts every request, which is what local dev and any deployment without a
# CDN need — and what makes the CDN decorative if it is left unset once one
# exists.
EDGE_SHARED_SECRET=""
